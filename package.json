{
  "name": "sucai-manager",
  "version": "0.1.0",
  "description": "素材库 - 自媒体视频/图片/音频本地管理工具",
  "main": "out/main/index.js",
  "author": "sucai",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && vue-tsc --noEmit -p tsconfig.node.json",
    "dist": "electron-vite build && electron-builder --win",
    "smoke": "electron-vite build && electron out/main/index.js --smoke-test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "wavesurfer.js": "^7.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0"
  }
}
